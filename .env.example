# LLM Providers (Configure at least one)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Vector Store & Search
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=it-support-rag
TAVILY_API_KEY=your_tavily_api_key_here

# Models & Security
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ADMIN_API_KEY=your_admin_secret_key

# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=IT SUPPORT Agentic rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# DO NOT set LANGSMITH_AGENT_ID or LANGSMITH_AGENT_ENVIRONMENT in Render.
# Setting them causes LangSmith to suppress traces due to agent address conflict with project routing.
